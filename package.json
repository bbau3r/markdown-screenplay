{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm -w markdown-screenplay-vuer run dev",
    "build": "npm run --workspaces build",
    "preview": "npm -w markdown-screenplay-vuer run preview",
    "test:unit": "npm -w markdown-screenplay-vuer run test:unit",
    "type-check": "npm run --workspaces type-check",
    "lint": "npm -w markdown-screenplay-vuer run lint",
    "deploy": "npm -w markdown-screenplay-vuer run deploy"
  }
}
